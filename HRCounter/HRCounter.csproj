<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="HRCounter.csproj.user" Condition="Exists('HRCounter.csproj.user')"/>
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <RootNamespace>HRCounter</RootNamespace>
        <AssemblyName>HRCounter</AssemblyName>
        <DebugType>portable</DebugType>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
        <FrameworkPathOverride>$(BeatSaberDir)\Beat Saber_Data\Managed</FrameworkPathOverride>
        <MarkPackageReferencesAsExternallyResolved>false</MarkPackageReferencesAsExternallyResolved>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="0Harmony">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Libs\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="BeatLeader">
            <Private>false</Private>
            <HintPath>$(BeatSaberDir)\Plugins\BeatLeader.dll</HintPath>
        </Reference>
        <Reference Include="BeatSaber.ViewSystem">
            <Private>false</Private>
        </Reference>
        <Reference Include="BGLib.AppFlow">
            <Private>false</Private>
        </Reference>
        <Reference Include="BGLib.Polyglot">
            <Publicize>true</Publicize>
            <Private>false</Private>
        </Reference>
        <Reference Include="BSML">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
        </Reference>
        <Reference Include="Counters+">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Plugins\Counters+.dll</HintPath>
        </Reference>
        <Reference Include="DataModels">
            <Private>false</Private>
        </Reference>
        <Reference Include="Hive.Versioning">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Libs\Hive.Versioning.dll</HintPath>
        </Reference>
        <Reference Include="HMLib">
            <Private>False</Private>
        </Reference>
        <Reference Include="HMUI">
            <Private>False</Private>
        </Reference>
        <Reference Include="IPA.Loader">
            <Private>False</Private>
        </Reference>
        <Reference Include="Main">
            <Private>False</Private>
        </Reference>
        <Reference Include="netstandard">
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Libs\Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="PlatformUserModel">
            <Private>false</Private>
        </Reference>
        <Reference Include="SiraUtil">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
        </Reference>
        <Reference Include="System.Data.DataSetExtensions">
            <Private>false</Private>
        </Reference>
        <Reference Include="System.Net.Http">
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UIElementsModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.UnityWebRequestModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.VRModule">
            <Private>False</Private>
        </Reference>
        <Reference Include="YUR.Fit.Unity">
            <Private>False</Private>
            <HintPath>$(BeatSaberDir)\Libs\YUR.Fit.Unity.dll</HintPath>
        </Reference>
        <Reference Include="Zenject">
            <Private>False</Private>
        </Reference>
        <Reference Include="Zenject-usage">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition=" '$(Configuration)' != 'Debug' ">
        <Compile Remove="Data\DataSources\DebugSource\**\*"/>
        <Compile Remove="Data\SourceDescriptors\DebugDescriptor\**\*"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="manifest.json"/>
        <EmbeddedResource Include="Resources\**\*"/>
        <EmbeddedResource Include="**\*.bsml"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="Directory.Build.props" Condition="Exists('Directory.Build.props')"/>
        <None Include="HRCounter.csproj.user" Condition="Exists('HRCounter.csproj.user')"/>
        <None Include="$(BeatSaberDir)\Logs\_latest.log" Condition="Exists('$(BeatSaberDir)\Logs\_latest.log')"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="BeatSaberModdingTools.Tasks">
            <Version>2.0.0-beta7</Version>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild">
            <Version>0.4.3</Version>
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Patches\"/>
    </ItemGroup>
</Project>
