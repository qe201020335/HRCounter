<vertical child-control-height='false' child-expand-height="false" spacing="2" pref-width="90" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <macro.define id="tab-width" value="90"/>
    <macro.define id="vertical-spacing" value="1.5"/>
    <horizontal pad-bottom="1">
        <horizontal background="panel-fade-gradient" pref-height="8" bg-color="#00c0ffff" pad-top='1'>
            <text text='Data Source' align='Center' font-size='6' italics='true'/>
        </horizontal>
    </horizontal>
    <tab-selector tab-tag='tabs'/>
    <tab tab-name="General" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <dropdown-list-setting text="Data Source" value="DataSource" choices="DataSourceOptions" apply-on-change="true" bind-value="true"/>
            <horizontal child-control-width='false' child-align="MiddleCenter">
                <horizontal horizontal-fit='PreferredSize' ignore-layout='false' child-align="MiddleLeft" pref-width="40">
                    <text text="Data Source Info ↓" align="Center" italics="true"/>
                </horizontal>
                <horizontal horizontal-fit='PreferredSize' child-align='MiddleRight' pref-width="40">
                    <button text="Refresh" id="data-source-info-refresh-btn" on-click="UpdateDataSourceInfoText"/>
                </horizontal>
            </horizontal>
            <horizontal pad-left="3" pref-height="45" background="round-rect-panel">
                <text-page id="data-source-info-text" italics="false"/>
            </horizontal>
        </vertical>
    </tab>
    <!--        <tab tab-name="Pulsoid" tags="tabs">-->
    <!--            <vertical child-control-height="false" spacing="1">-->
    <!--            </vertical>-->
    <!--        </tab>-->
    <!--        <tab tab-name="HypeRate" tags="tabs">-->
    <!--            <vertical child-control-height="false" spacing="1">-->
    <!--            </vertical>-->
    <!--        </tab>-->
</vertical>
