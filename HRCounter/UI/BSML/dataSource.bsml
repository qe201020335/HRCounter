<vertical child-control-height='false' child-expand-height="false" spacing="2" pref-width="90" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <macro.define id="tab-width" value="90"/>
    <macro.define id="vertical-spacing" value="1.5"/>
    <horizontal pad-bottom="1">
        <horizontal background="panel-top" pref-height="8" bg-color="#7f7f7f" bg-color0="#00c0ffff" bg-color1="#00c0ffff" pad-top='1'>
            <text text='Data Source' align='Center' font-size='6' italics='true'/>
        </horizontal>
    </horizontal>
    <tab-selector tab-tag='tabs'/>
    <tab tab-name="General" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text="Streamer Mode" value="StreamerMode" hover-hint="Hide tokens and ids" apply-on-change="true" bind-value="true"/>
            <dropdown-list-setting text="Data Source" value="DataSource" choices="DataSourceOptions" apply-on-change="true" bind-value="true"/>
            <horizontal child-control-width='false' child-align="MiddleCenter">
                <horizontal horizontal-fit='PreferredSize' ignore-layout='false' child-align="MiddleLeft" pref-width="40">
                    <text text="Data Source Info ↓" align="Center" italics="true"/>
                </horizontal>
                <horizontal horizontal-fit='PreferredSize' child-align='MiddleRight' pref-width="40">
                    <button text="Refresh" id="data-source-info-refresh-btn" on-click="UpdateDataSourceInfoText"/>
                </horizontal>
            </horizontal>
            <horizontal pad-left="3" pref-height="45" background="round-rect-panel">
                <text-page id="data-source-info-text" italics="false"/>
            </horizontal>
        </vertical>
    </tab>
    <tab tab-name="Pulsoid" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <horizontal pad-left="2" pad-right="2" pref-height="16" vertical-fit="PreferredSize" child-align="MiddleLeft" child-expand-height="false">
                <text text="~PulsoidTokenStatusText"/>
            </horizontal>
            <button id="authorize-pulsoid-btn" text="Authorize Pulsoid" on-click="OpenAuthorizeModal"/>
            <button id="deauthorize-pulsoid-btn" text="Deauthorize Pulsoid" click-event="show-pulsoid-deauthorize-modal"/>
        </vertical>
        <modal id="pulsoid-authorize-modal" show-event="show-pulsoid-authorize-modal" hide-event="close-modal" size-delta-x="80"
               size-delta-y="50" click-off-closes="false" move-to-center="true">
            <vertical pref-width="80" horizontal-fit="PreferredSize" pref-height="50" vertical-fit="PreferredSize" spacing="1"
                      background="round-rect-panel">
                <horizontal>
                    <text text="Authorize with Pulsoid" font-size="5" align="Center"/>
                </horizontal>
                <horizontal pad-left="4" pad-right="4">
                    <text text="~ModalText" bold="false" align="Center" word-wrapping="true"/>
                </horizontal>
                <horizontal pref-width="40" horizontal-fit="PreferredSize" spacing="20">
                    <button id="modal-close-button" text="~ModalCloseButtonText" on-click="CloseAuthorizeModal"/>
                    <action-button id="modal-authorize-button" text="Authorize" on-click="AuthorizePulsoid"/>
                </horizontal>
            </vertical>
        </modal>
        <modal show-event="show-pulsoid-deauthorize-modal" hide-event="close-modal" size-delta-x="80" size-delta-y="40" click-off-closes="true"
               move-to-center="true">
            <vertical pref-width="80" horizontal-fit="PreferredSize" pref-height="40" vertical-fit="PreferredSize" spacing="1"
                      background="round-rect-panel">
                <horizontal>
                    <text text="Deauthorize Pulsoid" font-size="5" align="Center"/>
                </horizontal>
                <horizontal pad-left="4" pad-right="4">
                    <text text="Are you sure you want to deauthorize Pulsoid?&#xA;This will invalidate the Pulsoid token." bold="false"
                          align="Center" word-wrapping="true"/>
                </horizontal>
                <horizontal pref-width="40" horizontal-fit="PreferredSize" spacing="20">
                    <button id="modal-close-button" text="Cancel" click-event="close-modal"/>
                    <button face-color="red" id="modal-deauthorize-button" text="Deauthorize" on-click="DeauthorizePulsoid"/>
                </horizontal>
            </vertical>
        </modal>
    </tab>
    <tab tab-name="HypeRate" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <horizontal child-control-width="false" child-expand-width="false" horizontal-fit="PreferredSize" spacing="1">
                <horizontal horizontal-fit="MinSize" min-width="30" child-expand-width="false">
                    <text text="HypeRate ID" align="MidlineLeft" italics="true"/>
                </horizontal>
                <horizontal spacing="3" horizontal-fit="MinSize" min-width="60" child-alignment="MiddleRight" child-expand-width="false">
                    <text id="hyperate-session-id-text" align="Midline" italics="true"/>
                    <button text="Edit" click-event="open-hyperate-id-keyboard" interactable="~AllowEdit"/>
                </horizontal>
                <modal-keyboard value='HypeRateSessionID' show-event="open-hyperate-id-keyboard" click-off-closes="true" clear-on-open="false"/>
            </horizontal>
        </vertical>
    </tab>
</vertical>
