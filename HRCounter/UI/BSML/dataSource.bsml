<vertical child-control-height='false' child-expand-height="false" spacing="2" pref-width="90" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <macro.define id="tab-width" value="90"/>
    <macro.define id="vertical-spacing" value="1.5"/>
    <horizontal pad-bottom="1">
        <horizontal background="panel-top" pref-height="8" bg-color="#7f7f7f" bg-color0="#00c0ffff" bg-color1="#00c0ffff" pad-top='1'>
            <text text-key="HRCOUNTER_DATA_SOURCE_MENU_PANEL_TITLE" align='Center' font-size='6' italics='true'/>
        </horizontal>
    </horizontal>
    <tab-selector tab-tag='tabs'/>
    <tab tab-name-key="HRCOUNTER_DATA_SOURCE_MENU_TAB_GENERAL" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text-key="HRCOUNTER_DATA_SOURCE_MENU_STREAMER_MODE_LABEL" value="StreamerMode"
                          hover-hint-key="HRCOUNTER_DATA_SOURCE_MENU_STREAMER_MODE_HINT" apply-on-change="true" bind-value="true"/>
            <dropdown-list-setting text-key="HRCOUNTER_DATA_SOURCE_MENU_SOURCE_DROPDOWN_LABEL" value="DataSource" choices="DataSourceOptions"
                                   formatter="GetDataSourceDisplayName" apply-on-change="true" bind-value="true"/>
            <horizontal child-control-width='false' child-align="MiddleCenter">
                <horizontal horizontal-fit='PreferredSize' ignore-layout='false' child-align="MiddleLeft" pref-width="40">
                    <text text-key="HRCOUNTER_DATA_SOURCE_MENU_SOURCE_INFO_HEADER" align="Center" italics="true"/>
                </horizontal>
                <horizontal horizontal-fit='PreferredSize' child-align='MiddleRight' pref-width="40">
                    <button text-key="HRCOUNTER_COMMON_REFRESH" on-click="UpdateDataSourceInfoText"
                            interactable="~DataSourceInfoRefreshBtnInteractable"/>
                </horizontal>
            </horizontal>
            <horizontal pad-left="3" pref-height="45" background="round-rect-panel">
                <text-page text="~DataSourceInfoText" italics="false"/>
            </horizontal>
        </vertical>
    </tab>
    <tab tab-name-key="HRCOUNTER_DATA_SOURCE_MENU_TAB_PULSOID" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <horizontal pad-left="2" pad-right="2" pref-height="16" vertical-fit="PreferredSize" child-align="MiddleLeft" child-expand-height="false">
                <text text="~PulsoidTokenStatusText"/>
            </horizontal>
            <button text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_AUTHORIZE_BUTTON" on-click="OpenAuthorizeModal"/>
            <button text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_DEAUTHORIZE_BUTTON" click-event="show-pulsoid-deauthorize-modal"
                    interactable="~PulsoidTokenValid"/>
        </vertical>
        <modal id="pulsoid-authorize-modal" show-event="show-pulsoid-authorize-modal" hide-event="close-modal" size-delta-x="80"
               size-delta-y="50" click-off-closes="false" move-to-center="true">
            <vertical pref-width="80" horizontal-fit="PreferredSize" pref-height="50" vertical-fit="PreferredSize" spacing="1"
                      background="round-rect-panel">
                <horizontal>
                    <text text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_AUTHORIZE_MODAL_TITLE" font-size="5" align="Center"/>
                </horizontal>
                <horizontal pad-left="4" pad-right="4">
                    <text text="~AuthModalText" bold="false" align="Center" word-wrapping="true"/>
                </horizontal>
                <horizontal pref-width="40" horizontal-fit="PreferredSize" spacing="20">
                    <button text="~AuthModalCloseBtnText" on-click="CloseAuthorizeModal"/>
                    <action-button text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_AUTHORIZE_MODAL_ACTION" on-click="AuthorizePulsoid"
                                   interactable="~AuthModalAuthBtnInteractable"/>
                </horizontal>
            </vertical>
        </modal>
        <modal show-event="show-pulsoid-deauthorize-modal" hide-event="close-modal" size-delta-x="80" size-delta-y="40" click-off-closes="true"
               move-to-center="true">
            <vertical pref-width="80" horizontal-fit="PreferredSize" pref-height="40" vertical-fit="PreferredSize" spacing="1"
                      background="round-rect-panel">
                <horizontal>
                    <text text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_DEAUTHORIZE_MODAL_TITLE" font-size="5" align="Center"/>
                </horizontal>
                <horizontal pad-left="4" pad-right="4">
                    <text text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_DEAUTHORIZE_MODAL_TEXT" bold="false" align="Center" word-wrapping="true"/>
                </horizontal>
                <horizontal pref-width="40" horizontal-fit="PreferredSize" spacing="20">
                    <button text-key="HRCOUNTER_COMMON_CANCEL" click-event="close-modal"/>
                    <button text-key="HRCOUNTER_DATA_SOURCE_MENU_PULSOID_DEAUTHORIZE_MODAL_ACTION" face-color="red" on-click="DeauthorizePulsoid"
                            interactable="~DeauthModalDeauthBtnInteractable"/>
                </horizontal>
            </vertical>
        </modal>
    </tab>
    <tab tab-name-key="HRCOUNTER_DATA_SOURCE_MENU_TAB_HYPERATE" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <horizontal child-control-width="false" child-expand-width="false" horizontal-fit="PreferredSize" spacing="1">
                <horizontal horizontal-fit="MinSize" min-width="30" child-expand-width="false">
                    <text text-key="HRCOUNTER_DATA_SOURCE_MENU_HYPERATE_ID_LABEL" align="MidlineLeft" italics="true"/>
                </horizontal>
                <horizontal spacing="3" horizontal-fit="MinSize" min-width="60" child-alignment="MiddleRight" child-expand-width="false">
                    <text text="~HypeRateSessionIDText" align="Midline" italics="true"/>
                    <button text-key="HRCOUNTER_COMMON_EDIT" click-event="open-hyperate-id-keyboard" interactable="~AllowEdit"/>
                </horizontal>
                <modal-keyboard value='HypeRateSessionID' show-event="open-hyperate-id-keyboard" click-off-closes="true" clear-on-open="false"/>
            </horizontal>
        </vertical>
    </tab>
</vertical>
