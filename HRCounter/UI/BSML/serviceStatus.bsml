<vertical child-control-height='false' child-expand-height="false" spacing="2" pref-width="90" xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
          xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <macro.define id="tab-width" value="90"/>
    <macro.define id="vertical-spacing" value="1.5"/>
    <horizontal pad-bottom="1">
        <horizontal background="panel-top" pref-height="8" bg-color="#7f7f7f" bg-color0="#00c0ffff" bg-color1="#00c0ffff"
                    child-align='MiddleRight' child-control-width='false'>
            <horizontal ignore-layout='true' pad-top='1'>
                <text text='Built-in Services' align='Center' font-size='6' italics='true'/>
            </horizontal>
            <horizontal horizontal-fit='PreferredSize' pad-right='1'>
                <button text='Refresh' on-click="RefreshStatus"/>
            </horizontal>
        </horizontal>
    </horizontal>
    <tab-selector tab-tag='tabs'/>
    <tab tab-name="HTTP" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text="Enable HTTP Server" value="EnableHttpServer" hover-hint="Enable the built-in HTTP server" apply-on-change="true"
                          bind-value="true"/>
            <horizontal pref-height="25" background="round-rect-panel" pad-top="-1" pad-left="3" pad-right="3" pad-bottom="-1">
                <text-page text="~HttpStatusText" italics="false"/>
            </horizontal>
        </vertical>
    </tab>
    <tab tab-name="OSC" tags="tabs">
        <vertical child-control-height="false" spacing="~vertical-spacing" horizontal-fit="PreferredSize" pref-width="~tab-width">
            <bool-setting text="Enable OSC Server" value="EnableOscServer" hover-hint="Enable the built-in OSC server" apply-on-change="true"
                          bind-value="true"/>
            <horizontal pref-height="25" background="round-rect-panel" pad-top="-1" pad-left="3" pad-right="3" pad-bottom="-1">
                <text-page text="~OscStatusText" italics="false"/>
            </horizontal>
        </vertical>
    </tab>
</vertical>
